<Window x:Class="Envoy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Envoy" Width="520" Height="250" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Envoy is running" FontSize="24" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Open this address on your phone or another computer:" Foreground="#FF64748B" />
            <TextBlock x:Name="AddressText" Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="The chat interface opens in your default browser." Margin="0,12,0,0" Foreground="#FF64748B" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy address" Padding="16,8" Click="Copy_Click" />
            <Button Content="Open chat" Padding="16,8" Margin="8,0,0,0" Click="OpenChat_Click" />
        </StackPanel>
    </Grid>
</Window>
